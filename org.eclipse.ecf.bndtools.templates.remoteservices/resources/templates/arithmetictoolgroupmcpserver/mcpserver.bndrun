-runstartlevel: \
    order = leastdependenciesfirst, \
    begin = 1000, \
    step  =    1

-runrequires: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.runtime',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='com.fasterxml.classmate';version='[1.7.0,2.0.0)',\
	bnd.identity;id='$basePackageName$',\
	bnd.identity;id='io.modelcontextprotocol.sdk.mcp-json-jackson2',\
	bnd.identity;id='org.openmcptools.transport.uds.spring',\
	bnd.identity;id='org.openmcptools.common.impl.spring'
	
-runvm: -Dorg.slf4j.simpleLogger.defaultLogLevel=debug
-resolve: beforelaunch
-runee: JavaSE-17
-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

